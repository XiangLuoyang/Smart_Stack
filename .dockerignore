# 构建上下文瘦身:避免把本地虚拟环境 / 依赖 / 缓存塞进镜像
.git
.gitignore
.cache
.claude
.agents
.codex

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
.venv/
venv/
env/
**/.venv/

# Node / 前端本地依赖与产物
frontend/node_modules/
frontend/dist/
frontend/.vite/
**/node_modules/

# 数据库与运行时数据(由挂载卷接管,不进镜像)
data/*.db
data/*.sqlite*
data/watchlist.json
backend/**/*.db

# 环境与机密(由 compose env_file / -e 注入)
.env
.env.*
!.env.example
backend/.env

# 编辑器与系统文件
.idea/
.vscode/
**/*.swp
**/*.swo
.DS_Store
Thumbs.db

# 实验性 Dockerfile / 脚本(不参与工作台构建)
Dockerfile.conda
Dockerfile.ta-test

