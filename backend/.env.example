# Smart Stack 操盘工作台 - 后端环境变量模板
# 复制为 .env 并按需修改

# ======================
# 数据库
# ======================
# DB_PATH=data/smartstack.db    # SQLite 文件路径(相对项目根)
# DB_URL=                       # 完整 SQLAlchemy URL,优先于 DB_PATH

# ======================
# 行情调度(秒)
# ======================
MARKET_QUOTE_POLL_SECONDS=60
MARKET_LIMIT_ORDER_MATCH_SECONDS=15
MARKET_STOP_LOSS_SCAN_SECONDS=30

# ======================
# A 股交易成本(可覆盖默认值)
# ======================
# FEES_COMMISSION_RATE=0.00025    # 佣金费率(双边)
# FEES_COMMISSION_MIN=5.0          # 佣金最低(元)
# FEES_STAMP_DUTY_RATE=0.001       # 印花税(仅卖出)
# FEES_TRANSFER_FEE_RATE=0.00002   # 过户费(沪市双边)

# ======================
# CORS(前端开发地址)
# ======================
# CORS_ORIGINS=["http://localhost:5173"]

# ======================
# LLM 配置(可选,信号源用)
# ======================
LLM_MODEL_NAME=deepseek/deepseek-chat
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.3

# ======================
# 调试
# ======================
DEBUG=true
